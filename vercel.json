{
  "version": 2,
  "builds": [
    {
      "src": "dist/main.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "dist/main.ts",
      "methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "HEAD"],
      "headers":{
        "Access-Control-Allow-Origin" : "*"
      }
    }
  ],
  "outputDirectory": "dist"
}
