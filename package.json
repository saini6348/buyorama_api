{
  "name": "buyorama_backoffice",
  "version": "1.0.0",
  "description": "Buyorama Backoffice API - NestJS backend for admin services",
  "main": "dist/main.js",
  "author": "Buyorama Team",
  "license": "ISC",
  "scripts": {
    "start": "node dist/main",
    "dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "build": "tsc",
    "watch": "tsc --watch",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "keywords": [
    "nestjs",
    "api",
    "backoffice",
    "buyorama"
  ],
  "dependencies": {
    "@nestjs/common": "^10.2.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.2.0",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-express": "^10.2.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^10.0.0",
    "@types/sanitize-html": "^2.16.1",
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^12.11.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "helmet": "^8.3.0",
    "pg": "^8.11.2",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.17.6",
    "sqlite3": "^6.0.1",
    "tslib": "^2.6.2",
    "typeorm": "^0.3.17",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.8.9",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  }
}
